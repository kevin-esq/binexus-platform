# Binexus.Api — multi-stage .NET 10 (SDK build → aspnet runtime, non-root)
# Build context: repository root
#   docker build -f infrastructure/docker/Dockerfile.api -t binexus-api .

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY apps/backend/Directory.Build.props apps/backend/
COPY apps/backend/Binexus.slnx apps/backend/
COPY apps/backend/.config apps/backend/.config
COPY apps/backend/src apps/backend/src

WORKDIR /src/apps/backend
RUN dotnet restore src/Binexus.Api/Binexus.Api.csproj

# Publish with OpenAPI-on-build off (host CI still generates artifacts/openapi).
ENV Jwt__SigningKey=docker-build-signing-key-with-more-than-thirty-two-bytes
RUN dotnet publish src/Binexus.Api/Binexus.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    -p:OpenApiGenerateDocumentsOnBuild=false \
    -p:UseAppHost=false

RUN dotnet tool restore \
 && dotnet ef migrations bundle \
      --project src/Binexus.Platform/Binexus.Platform.csproj \
      --startup-project src/Binexus.Api/Binexus.Api.csproj \
      --output /app/publish/efbundle \
      --force \
      --target-runtime linux-x64

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .
COPY infrastructure/docker/entrypoint-api.sh /app/entrypoint-api.sh
RUN chmod +x /app/entrypoint-api.sh /app/efbundle \
 && chown -R $APP_UID:$APP_UID /app

ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0 \
    RUN_MIGRATIONS=0

EXPOSE 8080
USER $APP_UID

HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=10 \
  CMD curl -fsS http://127.0.0.1:8080/health/ready || exit 1

ENTRYPOINT ["/app/entrypoint-api.sh"]
