# Optional operator web (Next.js) — profile `web` in compose.
# Build context: repository root. Prefer `pnpm --filter @binexus/web dev` on the host for day-to-day.
# NEXT_PUBLIC_* is baked at build time — pass as build-arg; never bake secrets.

ARG NEXT_PUBLIC_API_URL=http://localhost:5102

FROM node:22-bookworm-slim AS deps
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.1.1 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages packages
RUN pnpm install --frozen-lockfile --filter @binexus/web...

FROM deps AS build
ARG NEXT_PUBLIC_API_URL=http://localhost:5102
COPY apps/web apps/web
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN pnpm --filter @binexus/web build

FROM node:22-bookworm-slim AS final
ARG NEXT_PUBLIC_API_URL=http://localhost:5102
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN corepack enable && corepack prepare pnpm@11.1.1 --activate
COPY --from=build /repo /repo
WORKDIR /repo/apps/web
EXPOSE 3000
USER node
CMD ["pnpm", "exec", "next", "start", "-p", "3000"]
