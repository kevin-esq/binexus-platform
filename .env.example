### -----------------------------------------------
### Binexus Platform — Environment variables
### Copy to .env (and never commit it)
### -----------------------------------------------

### Node
NODE_ENV=development

### --- Backend (apps/backend) ---
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

### Postgres (matches infrastructure/compose/docker-compose.yml)
DATABASE_URL="postgresql://binexus:binexus@localhost:5432/binexus?schema=public"

### Redis
REDIS_URL="redis://localhost:6379"

### MinIO (S3-compatible)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="binexus"
S3_SECRET_KEY="binexus123"
S3_BUCKET="binexus-dev"

### Auth
JWT_ACCESS_SECRET="dev-access-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_REFRESH_TTL="7d"

### Seed
SEED_TENANT_SLUG="acme"
SEED_TENANT_NAME="Acme Corp"
SEED_ADMIN_EMAIL="admin@acme.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"

### Logging
LOG_LEVEL="debug"
LOG_PRETTY="true"

### --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
