{
  "name": "binexus-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Binexus operational SaaS platform — modular monolith, event-driven, offline-first, multi-tenant",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky",
    "docker:up": "docker compose -f infrastructure/compose/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/compose/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/compose/docker-compose.yml logs -f",
    "db:migrate": "dotenv -e .env -- pnpm --filter @binexus/backend prisma:migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @binexus/backend prisma:seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @binexus/backend prisma:studio"
  },
  "devDependencies": {
    "@binexus/config": "workspace:*",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
