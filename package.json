{
  "name": "binexus-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Binexus operational SaaS platform — modular monolith, event-driven, offline-first, multi-tenant",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:backend": "dotnet build apps/backend/Binexus.slnx -c Release",
    "dev": "dotenv -e .env -- turbo run dev --filter=@binexus/web --filter=@binexus/sdk --filter=@binexus/types --filter=@binexus/ui --filter=@binexus/config",
    "dev:web": "dotenv -e .env -- pnpm --filter @binexus/web dev",
    "dev:backend": "dotenv -e .env -- dotnet run --project apps/backend/src/Binexus.Api/Binexus.Api.csproj --no-launch-profile",
    "dev:api": "dotenv -e .env -- dotnet run --project apps/backend/src/Binexus.Api/Binexus.Api.csproj --no-launch-profile",
    "dev:workers": "dotenv -e .env -- dotnet run --project apps/backend/src/Binexus.Workers/Binexus.Workers.csproj --no-launch-profile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:backend": "dotnet test apps/backend/Binexus.slnx -c Release",
    "test:dotnet": "dotnet test apps/backend/Binexus.slnx -c Release",
    "test:integration": "dotnet test apps/backend/tests/Binexus.IntegrationTests/Binexus.IntegrationTests.csproj -c Release",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky",
    "docker:up": "docker compose -f infrastructure/compose/docker-compose.yml --env-file .env up -d --build",
    "docker:up:web": "docker compose -f infrastructure/compose/docker-compose.yml --env-file .env --profile web up -d --build",
    "docker:down": "docker compose -f infrastructure/compose/docker-compose.yml --profile web --profile seed down --remove-orphans",
    "docker:logs": "docker compose -f infrastructure/compose/docker-compose.yml logs -f",
    "docker:smoke": "bash apps/backend/scripts/gate6-compose-smoke.sh",
    "docker:smoke:win": "pwsh -File apps/backend/scripts/gate6-compose-smoke.ps1",
    "smoke:dotnet": "dotenv -e .env -- pnpm --filter @binexus/web smoke:dotnet",
    "db:migrate": "dotenv -e .env -- dotnet ef database update --project apps/backend/src/Binexus.Platform/Binexus.Platform.csproj --startup-project apps/backend/src/Binexus.Api/Binexus.Api.csproj",
    "db:migrate:script": "dotenv -e .env -- dotnet ef migrations script --idempotent --project apps/backend/src/Binexus.Platform/Binexus.Platform.csproj --startup-project apps/backend/src/Binexus.Api/Binexus.Api.csproj -o apps/backend/db/binexus-idempotent.sql",
    "db:seed:dev": "dotenv -e .env -- bash apps/backend/scripts/seed-dotnet.sh Development",
    "db:seed:testing": "dotenv -e .env -- bash apps/backend/scripts/seed-dotnet.sh Testing",
    "db:seed:dev:win": "dotenv -e .env -- pwsh -File apps/backend/scripts/seed-dotnet.ps1 -Environment Development",
    "db:seed:testing:win": "dotenv -e .env -- pwsh -File apps/backend/scripts/seed-dotnet.ps1 -Environment Testing"
  },
  "devDependencies": {
    "@binexus/config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.6",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/backend/**/*.cs": [
      "dotnet format apps/backend/Binexus.slnx --severity warn --include"
    ]
  }
}
