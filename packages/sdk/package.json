{
  "name": "@binexus/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client for the Binexus backend API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/problem-details.test.ts src/client.refresh.test.ts src/client.branch-activation.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@binexus/types": "workspace:*"
  },
  "devDependencies": {
    "@binexus/config": "workspace:*",
    "eslint": "^9.14.0",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3"
  }
}
