# Misc
.eslintcache
.prettiercache
.pnpm-store/

# Vendored skill source repos (referenced by .cursor/skills/*/SKILL.md but
# not part of the project). Drop them under skills/ locally; do not commit.
/skills/

# Graphify knowledge graph output (generated; rebuild via `graphify update .`)
**/graphify-out/
/.graphify/

# Local / ephemeral build artifacts (keep committed OpenAPI under artifacts/openapi/)
/artifacts/publish/
/artifacts/gate5-smoke/
/artifacts/gate6-smoke/
/artifacts/migrations/
# One-off demos from the web-artifacts skill
/artifacts/web-artifacts/

# Cursor IDE
# Track project-wide rules and skills under .cursor/{rules,skills}/.
# Ignore personal/runtime/local state and any hook scripts that depend on
# external infrastructure not bundled with this repo.
.cursor/hooks/
.cursor/hooks.json
.cursor/state/
.cursor/cache/
.cursor/.local/
.cursor/logs/
.cursor/*.log
.cursor/mcp.json
.cursor/mcp.local.json
