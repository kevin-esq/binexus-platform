// Binexus Foundation schema — Phase 0.
// ONLY foundation entities. Business modules (Orders, Inventory, Sales, ...) will add
// their own models in their respective phases.
//
// See docs/architecture/multi-tenant.md for the tenantId convention and the
// PrismaService extension that enforces it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
  WAREHOUSE
  DRIVER
}

enum OrderState {
  DRAFT
  APPROVED
  PICKING
  READY_FOR_ROUTE
  OUT_FOR_DELIVERY
  DELIVERED
  SETTLED
  CANCELLED
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  FAILED
}

enum StockMovementType {
  RESERVE
  RELEASE
  ADJUSTMENT
}

model Tenant {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  createdAt DateTime        @default(now())
  users     User[]
  branches  Branch[]
  features  TenantFeature[]
  orders    Order[]
}

model User {
  id               String            @id @default(cuid())
  tenantId         String
  email            String
  passwordHash     String
  role             Role
  branchId         String?
  isSystem         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id])
  refreshTokens    RefreshToken[]
  createdOrders    Order[]           @relation("OrderCreatedBy")
  orderTransitions OrderTransition[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, isSystem])
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  orders    Order[]

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Transactional outbox. Domain events are persisted here in the same DB transaction
/// as the command they originate from, and an async dispatcher publishes them.
model OutboxEvent {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  payload       Json
  version       Int       @default(1)
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  correlationId String?
  causationId   String?

  @@index([tenantId, publishedAt])
  @@index([name, publishedAt])
  @@index([publishedAt])
}

/// Immutable audit trail for domain events and operational actions.
/// `eventId` is unique so consumers remain idempotent across dispatcher retries.
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  eventId     String   @unique
  eventName   String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  payload     Json
  occurredAt  DateTime

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
}

model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Order {
  id              String            @id @default(cuid())
  tenantId        String
  branchId        String
  customerId      String
  state           OrderState        @default(DRAFT)
  totalCents      Int
  currency        String
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch            @relation(fields: [branchId], references: [id])
  createdBy       User              @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  lines           OrderLine[]
  transitions     OrderTransition[]

  @@index([tenantId, branchId])
  @@index([tenantId, customerId])
  @@index([tenantId, state])
  @@index([tenantId, createdAt])
}

model OrderLine {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
}

model OrderTransition {
  id         String      @id @default(cuid())
  tenantId   String
  orderId    String
  fromState  OrderState?
  toState    OrderState
  reason     String?
  byUserId   String
  occurredAt DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  byUser     User        @relation(fields: [byUserId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, occurredAt])
}

/// On-hand and reserved quantities per branch/product. Available = onHand - reserved (computed in code).
model StockItem {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  productId String
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, branchId, productId])
  @@index([tenantId, branchId])
}

/// Reservation promised to an order line. Idempotent per tenant/order/line.
model StockReservation {
  id          String                 @id @default(cuid())
  tenantId    String
  orderId     String
  orderLineId String
  branchId    String
  productId   String
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, orderId, orderLineId])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

/// Immutable stock movement ledger.
model StockMovement {
  id            String            @id @default(cuid())
  tenantId      String
  branchId      String
  productId     String
  orderId       String?
  orderLineId   String?
  type          StockMovementType
  quantity      Int
  correlationId String?
  causationId   String?
  occurredAt    DateTime          @default(now())

  @@index([tenantId, branchId, productId])
  @@index([tenantId, orderId])
}
