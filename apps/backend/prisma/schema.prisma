// Binexus Foundation schema — Phase 0.
// ONLY foundation entities. Business modules (Orders, Inventory, Sales, ...) will add
// their own models in their respective phases.
//
// See docs/architecture/multi-tenant.md for the tenantId convention and the
// PrismaService extension that enforces it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
  WAREHOUSE
  DRIVER
}

enum OrderState {
  DRAFT
  APPROVED
  PICKING
  READY_FOR_DELIVERY_ROUTE
  OUT_FOR_DELIVERY
  DELIVERED
  SETTLED
  CANCELLED
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  FAILED
}

enum StockTransferStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  RESERVE
  RELEASE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

model Tenant {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  createdAt DateTime        @default(now())
  users     User[]
  branches  Branch[]
  features  TenantFeature[]
  orders    Order[]
}

model User {
  id               String            @id @default(cuid())
  tenantId         String
  email            String
  passwordHash     String
  role             Role
  branchId         String?
  isSystem         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id])
  refreshTokens    RefreshToken[]
  createdOrders    Order[]           @relation("OrderCreatedBy")
  orderTransitions OrderTransition[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, isSystem])
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  orders    Order[]

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Transactional outbox. Domain events are persisted here in the same DB transaction
/// as the command they originate from, and an async dispatcher publishes them.
model OutboxEvent {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  payload       Json
  version       Int       @default(1)
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  correlationId String?
  causationId   String?

  @@index([tenantId, publishedAt])
  @@index([name, publishedAt])
  @@index([publishedAt])
}

/// Immutable audit trail for domain events and operational actions.
/// `eventId` is unique so consumers remain idempotent across dispatcher retries.
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  eventId     String   @unique
  eventName   String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  payload     Json
  occurredAt  DateTime

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
}

model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Order {
  id              String            @id @default(cuid())
  tenantId        String
  branchId        String
  customerId      String
  state           OrderState        @default(DRAFT)
  totalCents      Int
  currency        String
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch            @relation(fields: [branchId], references: [id])
  createdBy       User              @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  lines           OrderLine[]
  transitions     OrderTransition[]

  @@index([tenantId, branchId])
  @@index([tenantId, customerId])
  @@index([tenantId, state])
  @@index([tenantId, createdAt])
}

model OrderLine {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
}

model OrderTransition {
  id         String      @id @default(cuid())
  tenantId   String
  orderId    String
  fromState  OrderState?
  toState    OrderState
  reason     String?
  byUserId   String
  occurredAt DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  byUser     User        @relation(fields: [byUserId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, occurredAt])
}

/// On-hand and reserved quantities per branch/product. Available = onHand - reserved (computed in code).
model StockItem {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  productId String
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, branchId, productId])
  @@index([tenantId, branchId])
}

/// Reservation promised to an order line. Idempotent per tenant/order/line.
model StockReservation {
  id          String                 @id @default(cuid())
  tenantId    String
  orderId     String
  orderLineId String
  branchId    String
  productId   String
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, orderId, orderLineId])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

/// Immutable stock movement ledger.
model StockMovement {
  id            String            @id @default(cuid())
  tenantId      String
  branchId      String
  productId     String
  orderId       String?
  orderLineId   String?
  type          StockMovementType
  quantity      Int
  correlationId String?
  causationId   String?
  occurredAt    DateTime          @default(now())

  @@index([tenantId, branchId, productId])
  @@index([tenantId, orderId])
}

/// Branch-to-branch stock transfer request with lifecycle.
model StockTransfer {
  id                  String              @id @default(cuid())
  tenantId            String
  sourceBranchId      String
  destinationBranchId String
  productId           String
  quantity            Int
  status              StockTransferStatus @default(PENDING)
  reason              String?
  createdByUserId     String
  receivedByUserId    String?
  cancelledByUserId   String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  receivedAt          DateTime?
  cancelledAt         DateTime?

  @@index([tenantId, status])
  @@index([tenantId, sourceBranchId])
  @@index([tenantId, destinationBranchId])
  @@index([tenantId, productId])
}

enum PickingTaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Warehouse picking work for an order after stock is reserved.
model PickingTask {
  id                 String            @id @default(cuid())
  tenantId           String
  orderId            String
  branchId           String
  status             PickingTaskStatus @default(PENDING)
  createdFromEventId String?
  completedByUserId  String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  completedAt        DateTime?
  lines              PickingLine[]

  @@unique([tenantId, orderId])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
}

model PickingLine {
  id             String      @id @default(cuid())
  tenantId       String
  pickingTaskId  String
  orderLineId    String
  productId      String
  quantity       Int
  pickedQuantity Int         @default(0)
  createdAt      DateTime    @default(now())
  pickingTask    PickingTask @relation(fields: [pickingTaskId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pickingTaskId, orderLineId])
  @@index([tenantId, pickingTaskId])
}

enum DeliveryRouteStatus {
  PLANNED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum DeliveryRouteStopStatus {
  PLANNED
  DELIVERED
  FAILED
  SKIPPED
}

enum DeliveryRouteCandidateStatus {
  READY
  ASSIGNED
  CANCELLED
}

/// Planned delivery route for a branch.
model DeliveryRoute {
  id              String              @id @default(cuid())
  tenantId        String
  branchId        String
  status          DeliveryRouteStatus @default(PLANNED)
  driverUserId    String?
  plannedDate     DateTime?
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  stops           DeliveryRouteStop[]
  candidates      DeliveryRouteCandidate[]

  @@index([tenantId, status])
  @@index([tenantId, branchId])
}

/// Order stop on a delivery route.
model DeliveryRouteStop {
  id              String                  @id @default(cuid())
  tenantId        String
  deliveryRouteId String
  orderId         String
  sequence        Int
  status          DeliveryRouteStopStatus @default(PLANNED)
  createdAt       DateTime                @default(now())
  deliveryRoute   DeliveryRoute           @relation(fields: [deliveryRouteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deliveryRouteId, orderId])
  @@unique([tenantId, deliveryRouteId, sequence])
  @@index([tenantId, deliveryRouteId])
  @@index([tenantId, orderId])
}

/// Logistics projection of orders ready for delivery route assignment.
model DeliveryRouteCandidate {
  id                 String                       @id @default(cuid())
  tenantId           String
  orderId            String
  branchId           String
  status             DeliveryRouteCandidateStatus @default(READY)
  deliveryRouteId    String?
  createdFromEventId String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  deliveryRoute      DeliveryRoute?               @relation(fields: [deliveryRouteId], references: [id])

  @@unique([tenantId, orderId])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([tenantId, deliveryRouteId])
}
