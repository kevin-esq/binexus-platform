{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=binexus;Username=binexus;Password=binexus"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Security": {
    "MaxRequestBodyBytes": 1048576,
    "TrustedProxies": []
  },
  "Jwt": {
    "Issuer": "binexus",
    "Audience": "binexus-api",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "ClockSkew": "00:00:30"
  },
  "OutboxWorker": {
    "LockDuration": "00:02:00",
    "PollInterval": "00:00:02",
    "MaxAttemptsTransient": 10
  },
  "Features": {
    "LiquidationKillSwitch": true
  },
  "Logistics": {
    "Storage": {
      "Provider": "Local",
      "Endpoint": "http://localhost:5102",
      "Bucket": "binexus",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "PresignTtl": "00:15:00",
      "MinPresignTtl": "00:01:00",
      "MaxPresignTtl": "00:30:00",
      "MaxProofBytes": 10485760
    }
  }
}
