{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Binexus",
  "version": "0.1.0",
  "identifier": "io.binexus.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @binexus/desktop dev:vite",
    "beforeBuildCommand": "pnpm --filter @binexus/desktop build:vite",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Binexus",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
